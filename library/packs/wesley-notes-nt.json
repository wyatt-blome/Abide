{
  "id": "wesley-notes-nt",
  "author": "John Wesley",
  "title": "Explanatory Notes upon the New Testament",
  "edition": "CCEL text",
  "era": "puritan18c",
  "types": [
    "commentary"
  ],
  "rawUrls": [
    "https://ccel.org/ccel/w/wesley/notes/cache/notes.txt"
  ],
  "sourcePage": "https://ccel.org/ccel/wesley/notes",
  "license": {
    "status": "public-domain",
    "proofUrl": "https://ccel.org/ccel/wesley/notes",
    "proofText": "Rights: Public Domain",
    "basis": "rights-statement"
  },
  "parser": "verse-commentary",
  "parserOptions": {
    "layout": "ccel",
    "locatorFromRange": true,
    "sectionMaxChars": 4000,
    "headings": [
      {
        "pattern": "^(?:NOTES|EXPLANATORY NOTES) (?:ON|UPON) (.{3,100})$",
        "level": "book",
        "book": "$1",
        "flags": "i"
      },
      {
        "pattern": "^(?:CHAPTER|Chapter) ([IVXLC]+|\\d+)\\.?$",
        "level": "chapter",
        "label": "ch. $1"
      },
      {
        "pattern": "^(?:Verse )?(\\d{1,3})(?:\\s*[-,]\\s*(\\d{1,3}))?\\.\\s",
        "level": "verse",
        "verseEnd": "$2",
        "paragraphStart": true
      }
    ]
  },
  "defaultEnabled": true,
  "largePack": false,
  "bookScope": [
    [
      "MAT",
      "MRK",
      "LUK",
      "JHN",
      "ACT",
      "ROM",
      "1CO",
      "2CO",
      "GAL",
      "EPH",
      "PHP",
      "COL",
      "1TH",
      "2TH",
      "1TI",
      "2TI",
      "TIT",
      "PHM",
      "HEB",
      "JAS",
      "1PE",
      "2PE",
      "1JN",
      "2JN",
      "3JN",
      "JUD",
      "REV"
    ]
  ]
}
