  "sourcePage": "https://ccel.org/ccel/henry/mhc1",
  "license": {
    "status": "public-domain",
    "proofUrl": "https://ccel.org/ccel/henry/mhc1",
    "proofText": "Rights: Public Domain",
    "basis": "rights-statement"
  },
  "parser": "verse-commentary",
  "parserOptions": {
    "layout": "ccel",
    "locatorFromRange": true,
    "sectionMaxChars": 3000,
    "headings": [
      {
        "pattern": "^An Exposition,? [Ww]ith Practical Observations,? [Oo]f (.{3,120})$",
        "level": "book",
        "book": "$1",
        "intro": true,
        "label": "Introduction"
      },
      {
        "pattern": "^(?:CHAPTER|Chapter) (\\d+|[IVXLC]+)\\.?$",
        "level": "chapter",
        "label": "ch. $1"
      },
      {
        "pattern": "^(?:PSALM|Psalm) (\\d+|[IVXLC]+)\\.?$",
        "level": "chapter",
        "book": "PSA",
        "label": "Psalm $1"
      },
      {
        "pattern": "^Verses? (\\d+)(?:\\s*[-–]\\s*(\\d+))?\\.?$",
        "level": "verse",
        "verseEnd": "$2"
      }
    ]
  },
  "defaultEnabled": true,
  "largePack": false,
  "bookScope": [
