{
  "id": "henry-commentary",
  "author": "Matthew Henry",
  "title": "Commentary on the Whole Bible",
  "edition": "CCEL text (mhc1–mhc6)",
  "era": "puritan18c",
  "types": [
    "commentary"
  ],
  "rawUrls": [
    "https://ccel.org/ccel/h/henry/mhc1/cache/mhc1.txt",
    "https://ccel.org/ccel/h/henry/mhc2/cache/mhc2.txt",
    "https://ccel.org/ccel/h/henry/mhc3/cache/mhc3.txt",
    "https://ccel.org/ccel/h/henry/mhc4/cache/mhc4.txt",
