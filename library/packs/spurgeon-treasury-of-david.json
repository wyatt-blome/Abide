  "parser": "heading-range",
  "parserOptions": {
    "mappingMethod": "heading",
    "locatorFromRange": true,
    "sectionMaxChars": 6000,
    "headings": [
      {
        "pattern": "^PSALM ([IVXLC]+|\\d+)\\.?$",
        "level": "chapter",
        "book": "PSA"
      },
      {
        "pattern": "^EXPOSITION\\.?$",
        "level": "label",
        "label": "Exposition"
      },
      {
        "pattern": "^EXPLANATORY NOTES AND QUAINT SAYINGS\\.?$",
        "level": "label",
        "label": "Explanatory Notes and Quaint Sayings"
      },
      {
        "pattern": "^HINTS TO (?:THE )?VILLAGE PREACHER\\.?$",
        "level": "label",
        "label": "Hints to the Village Preacher"
      },
      {
        "pattern": "^(?:TITLE|SUBJECT|DIVISION)\\.?",
        "level": "label",
        "label": "Introduction",
        "paragraphStart": true
      },
      {
        "pattern": "^Verses? (\\d+)(?:\\s*[-–]\\s*(\\d+))?\\.",
        "level": "verse",
        "verseEnd": "$2",
        "paragraphStart": true
      }
    ]
  },
  "defaultEnabled": true,
  "largePack": false,
  "bookScope": [
    [
      "PSA"
    ],
    [
      "PSA"
    ]
  ]
