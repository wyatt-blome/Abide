    "proofText": "Rights: Public Domain",
    "basis": "rights-statement"
  },
  "parser": "verse-commentary",
  "parserOptions": {
    "layout": "ccel",
    "locatorFromRange": true,
    "sectionMaxChars": 6000,
    "headings": [
      {
        "pattern": "^CHAPTER ([IVX]+)\\.?$",
        "level": "chapter",
        "label": "ch. $1",
        "flags": "i"
      },
      {
        "pattern": "^(?:Ver(?:se)?\\.?|VERSE|VERS\\.) (\\d+)(?:\\s*[-–]\\s*(\\d+))?\\.",
        "level": "verse",
        "verseEnd": "$2",
        "paragraphStart": true
      }
    ]
  },
  "defaultEnabled": false,
  "largePack": false,
  "bookScope": [
    [
      "EPH"
    ]
  ]
