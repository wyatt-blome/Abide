{
  "id": "jfb-commentary",
  "author": "Robert Jamieson, A. R. Fausset and David Brown",
  "title": "Commentary Critical and Explanatory on the Whole Bible",
  "edition": "1871 (CCEL text)",
  "era": "c19",
  "types": [
    "commentary"
  ],
  "rawUrls": [
    "https://ccel.org/ccel/j/jamieson/jfb/cache/jfb.txt"
  ],
  "sourcePage": "https://ccel.org/ccel/jamieson/jfb",
  "license": {
    "status": "public-domain",
    "proofUrl": "https://ccel.org/ccel/jamieson/jfb",
    "proofText": "Rights: Public Domain",
    "basis": "rights-statement"
  },
  "parser": "verse-commentary",
  "parserOptions": {
    "layout": "ccel",
    "locatorFromRange": true,
    "sectionMaxChars": 4000,
    "headings": [
      {
        "pattern": "^([1-3]?[A-Z][a-z]{1,4}) (\\d+):(\\d+)(?:-(\\d+))?\\.",
        "level": "verse",
        "book": "$1",
        "chapter": "$2",
        "verse": "$3",
        "verseEnd": "$4",
        "paragraphStart": true
      }
    ]
  },
  "defaultEnabled": false,
  "largePack": true
}
