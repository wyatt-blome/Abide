  "parserOptions": {
    "locatorFromRange": true,
    "sectionMaxChars": 4000,
    "headings": [
      {
        "pattern": "^INTRODUCTION TO (?:[1-3] )?[A-Z ]+? (\\d+)$",
        "level": "chapter",
        "chapter": "$1",
        "label": "ch. $1"
      },
      {
        "pattern": "^Ver(?:se)?\\.? (\\d+)(?:\\s*[-–]\\s*(\\d+))?\\.",
        "level": "verse",
        "verseEnd": "$2",
        "paragraphStart": true
      }
    ]
  },
