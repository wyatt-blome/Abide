{
  "id": "clarke-commentary",
  "author": "Adam Clarke",
  "title": "Commentary on the Bible",
  "edition": "CCEL text (vol1–vol6), first published 1810–1826",
  "era": "c19",
  "types": [
    "commentary"
  ],
  "rawUrls": [
    "https://www.ccel.org/c/clarke/commentary/vol1.txt",
    "https://www.ccel.org/c/clarke/commentary/vol2.txt",
    "https://www.ccel.org/c/clarke/commentary/vol3.txt",
    "https://www.ccel.org/c/clarke/commentary/vol4.txt",
    "https://www.ccel.org/c/clarke/commentary/vol5.txt",
    "https://www.ccel.org/c/clarke/commentary/vol6.txt"
  ],
  "sourcePage": "https://www.ccel.org/c/clarke/commentary/",
  "license": {
    "status": "public-domain",
    "proofUrl": "https://www.ccel.org/c/clarke/commentary/",
    "proofText": "Clarke",
    "basis": "published-before-1931",
    "yearPattern": "\\b(18[0-2]\\d)\\b"
  },
  "parser": "verse-commentary",
  "parserOptions": {
    "locatorFromRange": true,
    "sectionMaxChars": 4000,
    "headings": [
      {
        "pattern": "^(?:INTRODUCTION TO|PREFACE TO) (.{3,100})$",
        "level": "book",
        "book": "$1",
        "intro": true,
        "label": "Introduction",
        "flags": "i"
      },
      {
        "pattern": "^CHAPTER ([IVXLC]+|\\d+)\\.?$",
        "level": "chapter",
        "label": "ch. $1"
      },
      {
        "pattern": "^Verse (\\d+)(?:\\s*[-.]\\s*(\\d+))?\\.",
        "level": "verse",
        "verseEnd": "$2",
        "paragraphStart": true
      }
    ]
  },
  "defaultEnabled": false,
  "largePack": true,
